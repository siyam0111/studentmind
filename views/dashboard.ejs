<%- include('partials/head', { title: title }) %>
<h1 class="h-md">Hello, <%= user.name %></h1>
<div class="grid">
  <div class="card">
    <h3>Your results</h3>
    <% if (!results.length) { %>
      <p class="muted">You have not saved any results yet.</p>
      <a class="btn ghost" href="/tests">Browse tests</a>
    <% } else { %>
      <% results.forEach(function (r) { %>
        <div class="row-link">
          <div><strong><%= r.title %></strong><br><span class="muted"><%= r.summary %> · <%= fmtDate(r.created_at) %></span></div>
          <a href="/results/<%= r.id %>">View</a>
        </div>
      <% }) %>
      <p></p><a class="btn ghost" href="/tests">Take another test</a>
    <% } %>
  </div>
  <div class="card">
    <h3>Your articles</h3>
    <p class="muted"><%= counts.pending %> pending review · <%= counts.published %> published · <%= counts.rejected %> rejected</p>
    <a class="btn ghost" href="/my-articles">My articles</a>
    <a class="btn ghost" href="/write">Write an article</a>
  </div>
  <div class="card">
    <h3>Saved articles</h3>
    <% if (!saved.length) { %>
      <p class="muted">Articles you bookmark appear here.</p>
    <% } else { %>
      <% saved.forEach(function (s) { %><div class="row-link"><a href="/articles/<%= s.id %>"><%= s.title %></a></div><% }) %>
    <% } %>
  </div>
</div>
<%- include('partials/foot') %>
