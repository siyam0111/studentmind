<%- include('partials/head', { title: title }) %>
<h1 class="h-md">Contact us</h1>
<div class="card form-card">
  <% if (errors.length) { %>
    <div class="flash error" role="alert"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
  <% } %>
  <form method="post" action="/contact">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="name">Name (optional)</label>
    <input id="name" name="name" maxlength="100" value="<%= form.name %>">
    <label for="email">Email (optional, so we can reply)</label>
    <input id="email" name="email" type="email" maxlength="255" value="<%= form.email %>">
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="6" maxlength="2000" required><%= form.message %></textarea>
    <button class="btn" type="submit">Send message</button>
  </form>
</div>
<%- include('partials/foot') %>
